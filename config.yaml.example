# =============================================================================
# Discord YouTube Bot 設定ファイル
# =============================================================================
# このファイルでBotの動作に必要な全ての設定を管理します。
# bot.py を編集せずに、このファイルのみで設定変更が可能です。
#
# 使用方法:
#   1. このファイルを config.yaml にコピー
#   2. 各設定値を実際の値に置き換え
# =============================================================================

# -----------------------------------------------------------------------------
# Discord設定
# -----------------------------------------------------------------------------
discord:
  # Discord Bot Token（Discord Developer Portalで取得）
  bot_token: "YOUR_DISCORD_BOT_TOKEN_HERE"

  # 監視対象のチャンネルID（複数指定可能）
  # チャンネルIDはDiscordの開発者モードを有効にして取得できます
  target_channel_ids:
    - 1234567890123456789
    # - 9876543210987654321  # 追加例：別サーバーのチャンネル

# -----------------------------------------------------------------------------
# YouTube設定
# -----------------------------------------------------------------------------
youtube:
  # 動画を追加するプレイリストID
  # プレイリストURLの「list=」以降の文字列
  playlist_id: "YOUR_YOUTUBE_PLAYLIST_ID_HERE"

  # OAuth認証ファイル（通常は変更不要）
  client_secrets_file: "client_secret.json"
  token_pickle_file: "token.pickle"

# -----------------------------------------------------------------------------
# Bot動作設定
# -----------------------------------------------------------------------------
bot:
  # 起動時に過去メッセージをスキャンする際の最大件数
  # 0 または null: 全件スキャン（チャンネル内の全メッセージをチェック）
  # 正の整数: 指定件数のみスキャン
  history_scan_limit: 0

  # プレイリスト追加成功時にDiscordに通知するか
  notify_on_success: true

  # 動画を追加できなかったとき・起動時にYouTube APIの準備ができなかったときに、Discordに通知するか
  # 失敗に気づけるよう、運用では true をおすすめします
  notify_on_error: false

  # Bot起動時にチャンネルに通知するか
  notify_on_start: true

  # Bot停止時にチャンネルに通知するか
  notify_on_stop: true

  # スキャン完了時にチャンネルに通知するか
  notify_on_scan_complete: true

# -----------------------------------------------------------------------------
# ログ設定
# -----------------------------------------------------------------------------
logging:
  # ログディレクトリ（スクリプトからの相対パスまたは絶対パス）
  log_directory: "logs"

  # ログファイル名（拡張子なし）
  bot_log_name: "bot"
  debug_log_name: "debug"

  # ログ保持日数（この日数を超えた古いログは自動削除）
  retention_days: 7

  # ログレベル
  # bot_log: INFO, WARNING, ERROR, CRITICAL のみ記録
  # debug_log: DEBUG以上の全てを記録
